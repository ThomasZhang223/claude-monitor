node_modules

# Your own boxes. Generated by the setup panel; never committed, so a pull
# cannot conflict with it and a fork cannot publish someone's directory layout.
config.json

# Untracked, and deliberately not committed: a public tool has no business
# pinning a user's npm registry. This file exists only when the machine's default
# registry points somewhere that 404s public packages (e.g. after an
# `aws codeartifact login --tool npm`).
.npmrc

# macOS Finder view preferences. Junk, and committed once by accident.
.DS_Store
